<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Settings" src="project://database/Assets/UI%20Toolkit/Settings.uxml?fileID=9197481963319205126&amp;guid=2118abaa7f2944543b218e79948ca8a9&amp;type=3#Settings" />
    <Style src="project://database/Assets/UI%20Toolkit/Styles.uss?fileID=7433441132597879392&amp;guid=6c2a7a29e6f6b5749a27053048a177da&amp;type=3#Styles" />
    <ui:VisualElement name="root" style="flex-grow: 1; flex-shrink: 1; flex-direction: row; justify-content: center;">
        <ui:VisualElement name="menu-container" class="menu__container" style="display: flex; justify-content: space-between;">
            <ui:Image name="game-title" enabled="true" class="game__title" style="--unity-image: url(&quot;project://database/Assets/UI%20Toolkit/Art/title_EN.png?fileID=2800000&amp;guid=4b54da4efdd5777419103f62ce0efdcb&amp;type=3#title_EN&quot;); display: none;" />
            <ui:VisualElement name="btns-block" class="menu-btns__block" style="display: none;">
                <ui:Button text="Button" name="play-btn" class="main__btn menu__btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(28502589440)" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Button" name="settings-btn" class="main__btn menu__btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(131489529856)" />
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="customization-container" class="menu-screen__container" style="display: none;">
                <ui:VisualElement name="cutomization-top-block" class="menu__top-block">
                    <ui:Label text="Label" name="customization-title" class="menu__title">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(3999451842441216)" />
                        </Bindings>
                    </ui:Label>
                    <ui:ScrollView name="skins-block" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" mode="Horizontal" touch-scroll-type="Clamped">
                        <ui:RadioButtonGroup label="Radio Button Group" value="0" focusable="true" name="skins-list" class="list">
                            <ui:RadioButton label="Radio Button" value="true" class="skins__item list__item" style="background-image: url(&quot;project://database/Assets/Materials/Textures/Enemy.png?fileID=2800000&amp;guid=bbc54c0e722a346408cd09eef6dc0cd6&amp;type=3#Enemy&quot;);" />
                            <ui:RadioButton label="Radio Button" class="skins__item list__item" style="background-image: url(&quot;project://database/Assets/Course%20Library/Textures/PolygonPrototype_Texture_Grid_08.png?fileID=2800000&amp;guid=1d12fa396a3563b41b9ae11b0fb0b986&amp;type=3#PolygonPrototype_Texture_Grid_08&quot;);" />
                            <ui:RadioButton label="Radio Button" class="skins__item list__item last-child" style="background-image: url(&quot;project://database/Assets/Materials/Skins/Textures/8%20ball.jpg?fileID=2800000&amp;guid=415a87c903390c84592b4ad26ec2a48c&amp;type=3#8 ball&quot;);" />
                        </ui:RadioButtonGroup>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="btns-block" class="control__btns__block">
                    <ui:Button text="Button" name="back-btn" class="main__btn">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(34371501490176)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="OK" name="ok-btn" class="main__btn last-child" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="level-container" class="menu-screen__container" style="display: none;">
                <ui:VisualElement name="level-top-block" class="menu__top-block">
                    <ui:Label text="Label" name="level-title" class="menu__title">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(2188047724773376)" />
                        </Bindings>
                    </ui:Label>
                    <ui:ScrollView name="levels-block" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                        <ui:RadioButtonGroup label="Radio Button Group" name="levels-list" value="0" class="list levels__list">
                            <ui:RadioButton label="Radio Button" value="false" class="list__item levels__item" />
                            <ui:RadioButton label="Radio Button" class="list__item levels__item" style="background-image: url(&quot;project://database/Assets/Materials/Textures/level%203.jpg?fileID=2800000&amp;guid=6f86369bf17066747b9bab760effb736&amp;type=3#level 3&quot;);" />
                            <ui:RadioButton label="Radio Button" class="list__item levels__item" style="background-image: url(&quot;project://database/Assets/Materials/Textures/level%201.jpg?fileID=2800000&amp;guid=13b79adf7923c2e46b66dad69b7d2951&amp;type=3#level 1&quot;);" />
                        </ui:RadioButtonGroup>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="btns-block" class="control__btns__block">
                    <ui:Button text="Button" name="back-btn" class="main__btn">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(34371501490176)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="OK" name="ok-btn" class="main__btn last-child" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="difficult-container" class="menu-screen__container" style="display: flex;">
                <ui:Label text="Label" name="difficult-title" class="menu__title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(1485044524609536)" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement name="butons-block" class="buttons__block-vertical">
                    <ui:Button text="Button" name="easy-btn" class="main__btn difficulty__btn first-child">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(25080031805440)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="Button" name="normal-btn" class="main__btn difficulty__btn">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(25157462851584)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="Button" name="hard-btn" class="main__btn difficulty__btn">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(25173317320704)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="Button" name="back-btn" class="main__btn last-child difficulty__btn" style="margin-top: auto;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:9f476537e2cbd4645b826c7bdcef67b0" entry="Id(34371501490176)" />
                        </Bindings>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings-window" class="popup popup-hidden">
            <ui:VisualElement name="popup-overlay" class="popup__overlay" />
            <ui:VisualElement name="popup-content" class="popup__content" style="width: 50%; height: 70%;">
                <ui:Instance template="Settings" name="settings" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
