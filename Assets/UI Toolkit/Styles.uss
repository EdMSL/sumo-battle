:root {
    --text-s: 24px;
    --text-m: 30px;
    --text-l: 40px;
    --text-xl: 60px;
    --padding-s: 20px;
    --padding-m: 40px;
    --padding-l: 60px;
    --padding-xl: 80px;
    --indent-s: 30px;
    --indent-m: 50px;
    --indent-l: 80px;
    --indent-xl: 100px;
    --main-color: rgb(46, 215, 145);
}

.hide {
    display: none;
}

.show {
    display: flex;
}

.menu__container {
    flex-direction: column;
    width: 50%;
    flex-grow: 0;
    height: 100%;
    padding-top: var(--indent-l);
    padding-bottom: var(--indent-l);
    flex-basis: auto;
    justify-content: space-between;
    align-items: center;
    align-self: auto;
}

.game__title {
    align-self: auto;
    justify-content: flex-start;
    align-items: auto;
    flex-grow: 0;
    max-height: 60%;
}

.menu-screen__container {
    display: flex;
    justify-content: space-between;
    flex-grow: 1;
    width: 100%;
    align-items: center;
}

.menu__top-block {
    flex-grow: 1;
    align-self: stretch;
}

.menu-btns__block {
    align-self: center;
    height: auto;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
}

.main__btn {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: var(--text-s);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-image: url("project://database/Assets/UI%20Toolkit/Art/button_rectangle_gradient_green.png?fileID=2800000&guid=bb8fef04c07792549ba7c710f7866985&type=3#button_rectangle_gradient_green");
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GardensC_03_1.otf?fileID=12800000&guid=948aec02539cfcd4389877be80b639e1&type=3#GardensC_03_1");
}

.menu__btn {
    margin-top: var(--indent-s);
    font-size: var(--text-xl);
    padding-top: var(--padding-l);
    padding-right: var(--padding-xl);
    padding-bottom: var(--padding-l);
    padding-left: var(--padding-xl);
}

.menu__title {
    -unity-font-style: normal;
    -unity-text-align: upper-center;
    font-size: var(--text-xl);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/SeymourOne-Regular.ttf?fileID=12800000&guid=0f03c94fa84679f44b05228813647d13&type=3#SeymourOne-Regular");
}

.buttons__block-vertical {
    flex-grow: 1;
}

.buttons__block-vertical > .first-child {
    margin-top: 0;
}

.control__btns__block {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: var(--indent-s);
}

.control__btns__block Button {
    padding-top: var(--padding-s);
    padding-bottom: var(--padding-s);
    padding-right: var(--padding-l);
    padding-left: var(--padding-l);
    margin-right: var(--indent-m);
    width: 300px;
}

.control__btns__block .last-child {
    margin-right: 0;
}

.popup {
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
}

.popup__overlay {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.62);
}

.popup__content {
    position: absolute;
    flex-grow: 1;
    translate: 0 -1050px;
    transition-property: translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out-back;
    background-image: url("project://database/Assets/UI%20Toolkit/Art/panel_gray.png?fileID=2800000&guid=83faf3ac4a49e0a4b8b97895314b175d&type=3#panel_gray");
    -unity-slice-type: tiled;
    -unity-slice-left: 18;
    -unity-slice-top: 18;
    -unity-slice-right: 18;
    -unity-slice-bottom: 18;
    -unity-slice-scale: 1px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GardensC_03_1.otf?fileID=12800000&guid=948aec02539cfcd4389877be80b639e1&type=3#GardensC_03_1");
}

.popup-hidden {
    top: -100%;
}

.popup-show {
    top: 0;
}

.popup-show .popup__content {
    background-color: rgb(255, 255, 255);
}

.animation__hide {
    translate: 0 -1050px;
    transition-timing-function: ease-in;
}

.animation__show {
    translate: 0 0;
}

.list > Label {
    display: none;
}

.list .unity-radio-button-group__container {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
}

.list--vertical {
}

.menu-screen__container .unity-scroller {
    height: 60px;
}

.menu-screen__container .unity-scroller .unity-repeat-button {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    width: 60px;
    height: 60px;
}

.menu-screen__container .unity-scroller .unity-scroller__high-button {
    background-image: url("project://database/Assets/UI%20Toolkit/Art/arrow_decorative_e_small.png?fileID=2800000&guid=5eef6f7a5f503164cbc3d41af5106c7b&type=3#arrow_decorative_e_small");
}

.menu-screen__container .unity-scroller .unity-scroller__low-button {
    background-image: url("project://database/Assets/UI%20Toolkit/Art/arrow_decorative_w_small.png?fileID=2800000&guid=5f5588187ab19c445add79f10dbd5eaf&type=3#arrow_decorative_w_small");
}

.menu-screen__container .unity-scroller__slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    visibility: hidden;
}

.menu-screen__container .unity-scroller__slider .unity-base-slider__dragger {
    background-color: rgb(47, 215, 146);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    visibility: hidden;
}

.list__item {
    width: 300px;
    height: 250px;
    margin-right: var(--indent-m);
}

.list__item > Label {
    display: none;
}

.list__item.last-child {
    margin-right: 0;
}

.list--vertical .list__item {
    margin-left: var(--indent-m);
}

.list--vertical .list__item.last-child {
    margin-right: var(--indent-m);
}

.list__item .unity-radio-button__checkmark-background {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.list__item .unity-radio-button__checkmark {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: initial;
    border-right-width: initial;
    border-bottom-width: initial;
    border-left-width: initial;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/UI%20Toolkit/Art/checkmark_green.png?fileID=2800000&guid=c92f8d82e0eb37a4aa23703dfc645bc4&type=3#checkmark_green");
    background-size: 30% 30%;
    background-color: rgba(0, 0, 0, 0);
}

.list__item .unity-base-field__input {
}

.levels__list .unity-radio-button-group__container {
    flex-direction: column;
    align-items: center;
}

.levels__item {
    background-image: url("project://database/Assets/Materials/Textures/level%202.jpg?fileID=2800000&guid=811f150c3b44b7c4c89480e7cb50f986&type=3#level 2");
    background-size: contain;
    width: 400px;
}

.difficulty__btn {
    padding: var(--padding-m);
    margin-top: var(--indent-s);
    padding-top: 40px;
    padding-right: 60px;
    padding-bottom: 40px;
    padding-left: 60px;
    font-size: var(--text-m);
}

.difficulty__btn .last-child {
    margin-top: auto;
}

.game-menu-btn {
    font-size: var(--text-l);
    padding-top: var(--padding-m);
    padding-right: var(--padding-xl);
    padding-bottom: var(--padding-m);
    padding-left: var(--padding-xl);
    margin-top: var(--indent-m);
}

.game-menu__container {
    padding-top: var(--padding-s);
    padding-right: var(--padding-m);
    padding-bottom: var(--padding-m);
    padding-left: var(--padding-m);
}

.game-menu__container .game__title {
    flex-grow: 1;
    max-height: none;
}

.game-menu__container .buttons__block-vertical {
    flex-shrink: 0;
}

.game-menu__container .buttons__block-vertical .game-menu-btn.last-child {
}

.countdown__container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/SeymourOne-Regular.ttf?fileID=12800000&guid=0f03c94fa84679f44b05228813647d13&type=3#SeymourOne-Regular");
    font-size: 140px;
    color: rgb(255, 255, 255);
}

.countdown__container > Label {
    transition-property: opacity;
    transition-duration: 500ms;
}

.countdown__title-hide {
    opacity: 0;
}

.countdown__title-show {
    opacity: 1;
    transition-duration: 0s;
}

.hud__container {
    display: flex;
    position: absolute;
    top: 0;
    right: 0;
    flex-direction: row-reverse;
    padding-top: var(--padding-s);
    padding-bottom: var(--padding-s);
    padding-right: var(--padding-l);
    padding-left: var(--padding-l);
    background-color: rgb(50, 50, 50);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/SeymourOne-Regular.ttf?fileID=12800000&guid=0f03c94fa84679f44b05228813647d13&type=3#SeymourOne-Regular");
}

.hud__item {
    flex-direction: row;
    -unity-font-style: bold;
    font-size: var(--text-l);
    color: var(--main-color);
    flex-grow: 1;
    margin-left: var(--indent-m);
}

.hud__item.last-child {
    margin-left: 0;
}

.hud__counter {
    flex-direction: row-reverse;
}

.end-game__container {
    -unity-text-align: upper-center;
    flex-grow: 1;
    font-size: var(--text-m);
    padding-top: var(--padding-l);
    padding-right: var(--padding-m);
    padding-bottom: var(--padding-m);
    padding-left: var(--padding-m);
}

.end-game__title {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-bottom: var(--indent-s);
    font-size: var(--text-l);
}

.end-game__btns {
    flex-direction: row;
    justify-content: space-around;
    flex-shrink: 0;
    align-self: stretch;
    margin-top: auto;
}

.end-game__btns > Button {
    flex-grow: 1;
    padding-top: var(--padding-s);
    padding-right: var(--padding-m);
    padding-bottom: var(--padding-s);
    padding-left: var(--padding-m);
    margin-right: var(--indent-s);
    flex-shrink: 1;
}

.end-game__btns > Button.last-child {
    margin-right: 0;
}

.mobile-controls__container {
    flex-grow: 1;
    justify-content: space-between;
}

.controls__container {
    margin-top: 0;
    flex-direction: row;
    justify-content: space-between;
    align-self: auto;
    align-items: stretch;
    padding-top: var(--padding-l);
}

.controls__block {
    flex-direction: row;
    align-items: center;
    margin-left: var(--indent-l);
    margin-right: var(--indent-l);
    justify-content: center;
}

.controls__block-vertical {
    flex-direction: column;
}

.controls__btn {
    width: 160px;
    height: 160px;
    margin-left: var(--indent-s);
    margin-right: var(--indent-s);
}

.controls__block-vertical > .controls__btn {
    margin-bottom: var(--indent-m);
}
