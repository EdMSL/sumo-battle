:root {
    --text-s: 24px;
    --text-m: 30px;
    --text-l: 40px;
    --text-xl: 60px;
    --padding-s: 20px;
    --padding-m: 40px;
    --padding-l: 60px;
    --padding-xl: 80px;
    --indent-s: 30px;
    --indent-m: 50px;
    --indent-l: 80px;
    --indent-xl: 100px;
}

.menu__container {
    flex-direction: column;
    width: 50%;
    flex-grow: 0;
    height: 100%;
    padding-top: 0;
    padding-bottom: 6%;
    flex-basis: auto;
    justify-content: space-between;
    align-items: center;
    align-self: auto;
}

.game__title {
    align-self: auto;
    justify-content: flex-start;
    align-items: auto;
    flex-grow: 0;
    max-height: 60%;
}

.menu-btns__block {
    align-self: center;
    height: auto;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
}

.main__btn {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(0, 0, 0, 0.13);
    font-size: 30px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.menu__btn {
    margin-top: var(--indent-s);
    font-size: var(--text-xl);
    padding-top: var(--padding-l);
    padding-right: var(--padding-xl);
    padding-bottom: var(--padding-l);
    padding-left: var(--padding-xl);
}

.menu__title {
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 30px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
}

.settings__block {
    justify-content: flex-start;
    align-items: center;
    width: 50%;
    height: 70%;
    max-width: none;
    max-height: none;
    flex-direction: column;
    background-color: rgb(255, 255, 255);
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
}

.options__list {
    flex-grow: 1;
    width: 50%;
}

.options__block__title {
    -unity-font-style: bold;
    font-size: var(--text-m);
    -unity-text-align: upper-center;
}

.options__block Slider {
    font-size: var(--text-s);
}

.options__block Toggle {
    font-size: var(--text-s);
}

.control__btns__block {
    flex-direction: row;
    justify-content: space-between;
    width: 70%;
}

.control__btns__block Button {
    margin-top: var(--indent-s);
    padding-top: var(--padding-s);
    padding-bottom: var(--padding-s);
    padding-right: var(--padding-l);
    padding-left: var(--padding-l);
}

.hud__item {
    flex-direction: row;
    -unity-font-style: normal;
    font-size: 34px;
    color: rgb(255, 255, 255);
}

.hud__counter {
    -unity-font-style: bold;
    flex-direction: row-reverse;
    padding-right: 20px;
}

.popup {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
}

.popup__title {
    font-size: var(--text-l);
}

.end-game__menu {
    -unity-text-align: upper-center;
    font-size: 30px;
}

.end-game__title {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-bottom: 20px;
    font-size: 40px;
}

.end-game__btns {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    flex-shrink: 0;
    align-self: stretch;
    padding-top: 20px;
}

.settings__container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.settings__container-hidden {
    background-color: rgba(0, 0, 0, 0.62);
    display: none;
}

.settings__container-hidden #settings-block {
    translate: 0 -1050px;
    transition-property: position;
    transition-duration: 1s;
}

.settings__container-show {
    background-color: rgba(0, 0, 0, 0.82);
    display: flex;
}

.settings__container-show #settings-block {
    translate: 0 0;
    transition-property: position;
    transition-timing-function: ease-out;
    transition-duration: 1s;
}
