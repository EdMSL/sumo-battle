
:root {
  --main-menu-btn-font-size: 30px;
}

.menu__container {
    flex-direction: column;
    width: auto;
    justify-content: space-between;
    align-content: auto;
    flex-grow: 1;
    height: 100%;
    max-width: 50%;
    align-items: center;
    align-self: auto;
    padding-top: 5%;
    padding-bottom: 10%;
    flex-basis: auto;
}

.game__title {
    font-size: 100px;
    -unity-font-style: bold;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 0;
    align-self: stretch;
    justify-content: flex-start;
    -unity-text-align: lower-center;
    white-space: normal;
    height: auto;
    width: 100%;
    align-items: stretch;
}

.menu-btns__block {
    max-width: none;
    align-self: stretch;
    flex-grow: 0;
    height: auto;
    justify-content: space-between;
    align-items: center;
    min-height: 30%;
}

.menu__btn {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(0, 0, 0, 0.13);
    font-size: var(--main-menu-btn-font-size);
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    flex-grow: 1;
    flex-basis: auto;
    min-height: auto;
    min-width: 300px;
    align-self: auto;
}

.menu__title {
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 30px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
}

.settings__container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.84);
    align-items: center;
    justify-content: center;
    display: none;
}

.settings__block {
    justify-content: flex-start;
    align-items: center;
    width: 50%;
    height: 50%;
    max-width: 500px;
    max-height: 500px;
    flex-direction: column;
    background-color: rgb(255, 255, 255);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 20px;
    padding-left: 10px;
}

.options__container {
}

.options__block__title {
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: upper-center;
}

.control__btns__block {
    flex-direction: row;
    justify-content: space-between;
}

.hud__item {
    flex-direction: row;
    -unity-font-style: normal;
    font-size: 34px;
    color: rgb(255, 255, 255);
}

.hud__counter {
    -unity-font-style: bold;
    flex-direction: row-reverse;
    padding-right: 20px;
}

.popup {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
}

.end-game__menu {
    -unity-text-align: upper-center;
    font-size: 30px;
}

.end-game__title {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-bottom: 20px;
    font-size: 40px;
}

.end-game__btns {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    flex-shrink: 0;
    align-self: stretch;
    padding-top: 20px;
}

.end-game__btn {
}
